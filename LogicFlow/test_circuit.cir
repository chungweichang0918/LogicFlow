ADD PIN IN_A
ADD PIN IN_B
ADD PIN IN_C
ADD AND G_AND
ADD OR G_OR
ADD NOT G_NOT
ADD NAND G_NAND
ADD XOR G_XOR
ADD XNOR G_XNOR
CONNECT IN_A G_AND
CONNECT IN_B G_AND
CONNECT IN_A G_OR
CONNECT IN_B G_OR
CONNECT IN_C G_NOT
CONNECT IN_A G_NAND
CONNECT IN_B G_NAND
CONNECT IN_A G_XOR
CONNECT IN_B G_XOR
CONNECT IN_A G_XNOR
CONNECT IN_B G_XNOR
OUT G_AND
OUT G_OR
OUT G_NOT
OUT G_NAND
OUT G_XOR
OUT G_XNOR
