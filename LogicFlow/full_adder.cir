ADD PIN IN_A
ADD PIN IN_B
ADD PIN IN_CIN
ADD XOR GATE_XOR1
ADD AND GATE_AND1
ADD XOR GATE_SUM
ADD AND GATE_AND2
ADD OR GATE_COUT
CONNECT IN_A GATE_XOR1
CONNECT IN_B GATE_XOR1
CONNECT IN_A GATE_AND1
CONNECT IN_B GATE_AND1
CONNECT GATE_XOR1 GATE_SUM
CONNECT IN_CIN GATE_SUM
CONNECT GATE_XOR1 GATE_AND2
CONNECT IN_CIN GATE_AND2
CONNECT GATE_AND1 GATE_COUT
CONNECT GATE_AND2 GATE_COUT
OUT GATE_SUM
OUT GATE_COUT
