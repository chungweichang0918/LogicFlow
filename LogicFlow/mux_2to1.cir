ADD PIN IN_D0
ADD PIN IN_D1
ADD PIN IN_SEL
ADD NOT GATE_NOT_SEL
ADD AND GATE_AND0
ADD AND GATE_AND1
ADD OR GATE_OUT
CONNECT IN_SEL GATE_NOT_SEL
CONNECT IN_D0 GATE_AND0
CONNECT GATE_NOT_SEL GATE_AND0
CONNECT IN_D1 GATE_AND1
CONNECT IN_SEL GATE_AND1
CONNECT GATE_AND0 GATE_OUT
CONNECT GATE_AND1 GATE_OUT
OUT GATE_OUT
